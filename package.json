{
	"name": "david-lovelace-archive",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"data:download": "node scripts/download-data.mjs",
		"inventory:parse": "node scripts/audit/parse-inventory.mjs",
		"inventory:duckdb": "duckdb static/data/archive.duckdb \"CREATE OR REPLACE TABLE files AS SELECT * FROM read_csv_auto('catalog/archive-inventory.csv');\"",
		"archive:audit": "node scripts/audit/archive-summary.mjs",
		"prepare": "svelte-kit sync || echo '' && husky install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md}": [
			"prettier --write"
		],
		"*.{js,ts,svelte}": [
			"eslint --fix"
		]
	},
	"devDependencies": {
		"@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0",
		"@maplibre/maplibre-gl-geocoder": "^1.9.4",
		"maplibre-gl": "^5.24.0",
		"pmtiles": "^4.4.1"
	}
}
